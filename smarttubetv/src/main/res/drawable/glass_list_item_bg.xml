<?xml version="1.0" encoding="utf-8"?>
<!-- CLEAN UI: focused row in the settings panel is a glass pill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#33FFFFFF" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#47FFFFFF" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
