<?xml version="1.0" encoding="utf-8"?>
<!--
    CLEAN UI: focused row in a settings panel.
    A flat highlight without an edge or a sheen: the panel itself is the glass, and glass on glass gets muddy.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#2EFFFFFF" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
