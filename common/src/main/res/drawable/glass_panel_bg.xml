<?xml version="1.0" encoding="utf-8"?>
<!--
    CLEAN UI: clear glass, for controls that float over video.
    Three layers: a dark tint that keeps white icons readable on a bright picture,
    a soft sheen (illumination) and a hairline edge. API 23+ adds a light catch on the edge, see drawable-v23.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A6101114" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#08FFFFFF"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
