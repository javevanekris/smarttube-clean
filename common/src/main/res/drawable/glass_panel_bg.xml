<?xml version="1.0" encoding="utf-8"?>
<!-- CLEAN UI: glass panel. Same recipe as the pill, with a card radius. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C101114" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#0AFFFFFF"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
        </shape>
    </item>
</layer-list>
