<?xml version="1.0" encoding="utf-8"?>
<!-- CLEAN UI: glass pill. Dark tint for legibility, a soft top-to-bottom sheen and a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A6101114" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3DFFFFFF"
                android:endColor="#0FFFFFFF"
                android:type="linear" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="#52FFFFFF" />
        </shape>
    </item>
</layer-list>
