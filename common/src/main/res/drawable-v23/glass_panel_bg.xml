<?xml version="1.0" encoding="utf-8"?>
<!--
    CLEAN UI: clear glass, for controls that float over video.
    Same as the base version, plus the highlight layer: light catching the top edge, a fainter one on the bottom edge.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A6101114" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#08FFFFFF"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
    <item android:height="1.5dp" android:gravity="top" android:left="28dp" android:right="28dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#B3FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="bottom" android:left="28dp" android:right="28dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
