<?xml version="1.0" encoding="utf-8"?>
<!--
    CLEAN UI: regular glass pill, for a short text over video (the skip notification).
    Same as the base version, plus a light catch on the top edge.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC101114" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:endColor="#0AFFFFFF"
                android:type="linear" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:left="22dp" android:right="22dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#A6FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
